{
  "manifest_version": 3,
  "name": "ScrollFlow for YouTube",
  "version": "1.0",
  "description": "Sticky video with smart right-side-only scroll behavior.",
  "permissions": ["activeTab"],
  "icons": {
  "128": "icon.png"},
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}
